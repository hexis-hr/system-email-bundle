{
    "name": "hexis/system-email-bundle",
    "version": "0.1.0",
    "description": "Configurable system emails: declare email types in YAML, manage their recipients (TO/CC/BCC) and a per-type send kill-switch in a backend UI, deliver via Symfony Mailer.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "mailer", "email", "recipients", "notifications", "bundle"],
    "authors": [
        {
            "name": "Hexis"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-bundle": "^2.10 || ^3.0",
        "doctrine/orm": "^2.9 || ^3.0",
        "doctrine/persistence": "^2.5 || ^3.0 || ^4.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/form": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/mailer": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/mime": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/validator": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "twig/twig": "^2.14 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "symfony/browser-kit": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/console": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/css-selector": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/messenger": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/messenger": "Dispatch outgoing mail asynchronously via SendEmailMessage instead of sending in-request.",
        "symfony/translation": "Translate type labels and admin UI strings."
    },
    "autoload": {
        "psr-4": {
            "Hexis\\SystemEmailBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hexis\\SystemEmailBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
